      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "FastAPI Monolith\n\n1. Ingest media\n2. Persist artifact + request\n3. Queue background job\n4. Run EasyOCR\n5. Run rules engine\n6. Call SageMaker artifact reasoner\n7. Call SageMaker tamper detector\n8. Call SageMaker synthetic detector\n9. Fuse verdict\n10. Annotate artifact\n11. Send result via GOWA\n\nDev endpoint mirrors the same result schema",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FastAPI Monolith\n\n1. Ingest media\n2. Persist artifact + request\n3. Queue background job\n4. Run EasyOCR\n5. Run rules engine\n6. Call SageMaker artifact reasoner\n7. Call SageMaker tamper detector\n8. Call SageMaker synthetic detector\n9. Fuse verdict\n10. Annotate artifact\n11. Send result via GOWA\n\nDev endpoint mirrors the same result schema",
      "lineHeight": 1.25
    },
