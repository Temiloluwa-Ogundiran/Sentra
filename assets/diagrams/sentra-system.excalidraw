    {
      "id": "api_text",
      "type": "text",
      "x": 650,
      "y": 95,
      "width": 300,
      "height": 330,
      "angle": 0,
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
